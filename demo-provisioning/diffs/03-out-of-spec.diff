--- src/api.py
+++ src/api.py
@@ -6,3 +6,13 @@
     if state is None:
         return 404, {"error": "device not found"}
     return 200, {"mac": mac, "state": state}
+
+
+def list_devices(registry, state=None):
+    """列出所有裝置,可依狀態過濾。"""
+    items = [
+        {"mac": m, "state": s}
+        for m, s in registry._devices.items()
+        if state is None or s == state
+    ]
+    return 200, {"devices": items}
